STUDY_CONFIG=config.local.json
STUDY_DATA_DIR=data
STUDY_SECRETS_DIR=secrets
STUDY_MAX_TEXT_BYTES=2000000
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# При необходимости MTProto через официальный WebSocket Telegram:
# TELEGRAM_TRANSPORT=wss
# TELEGRAM_HTTP_PROXY=http://username:password@host:port
# Либо путь к закрытому JSON с host/httpPort/username/password:
# TELEGRAM_PROXY_CONFIG=/absolute/path/network-proxy.json
YANDEX_ADDRESS=
YANDEX_APP_PASSWORD=
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
YANDEX_CALENDAR_USERNAME=
# Отдельный пароль приложения «Календарь», не пароль приложения «Почта».
YANDEX_CALENDAR_APP_PASSWORD=
# Google отключен по умолчанию (features.googleCalendar=false).
# Ключи нужны только при явном включении Google и выборе его для календарной роли.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Только для отдельного локального прогона модели, не для обычного сервиса:
# STUDY_EVAL_MODEL=
